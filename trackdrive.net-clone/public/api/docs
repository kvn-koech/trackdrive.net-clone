e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a String","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"caller_id","full_name":"caller_id","description":"\n\u003cp\u003eThe callerID for the lead. This is the number Trackdrive will dial when making outbound calls to the lead. This is also the number where Trackdrive will send SMS.\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a String","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"email","full_name":"email","description":"\n\u003cp\u003eThe email address for the lead. The lead’s email is required for sending emails from schedules to leads.\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a String","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"contact_field_type","full_name":"contact_field_type","description":"\n\u003cp\u003ePass an ID belonging to an \u003ccode\u003eAgent Script \u0026amp; Field Type\u003c/code\u003e to select that \u003ccode\u003eCustom Contact Field Type\u003c/code\u003e for this call.\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a String","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"schedule_callback_at","full_name":"schedule_callback_at","description":"\n\u003cp\u003eSchedule a callback with the submitted lead. Must be a valid time EG: 2021-07-23 14:26:43 +0000\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a valid time: 2026-10-08 15:57:42 +0000","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"schedule_callback_in_seconds","full_name":"schedule_callback_in_seconds","description":"\n\u003cp\u003eSchedule a callback with the submitted lead in X seconds. Must be a valid integer EG: 3600\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a String","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"update_all_matching_leads","full_name":"update_all_matching_leads","description":"\n\u003cp\u003eIf this is true, then the data sent in this request will be applied to all leads that match the Offer or Schedule and caller_id sent in the request. An example usecase is if you are sending a tracking token and want it applied to a lead that is present on two schedules (auto, life) under one offer (insurance)\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a boolean value: 1, true, yes, on, 0, false, no, off","expected_type":"boolean","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"apply_to","full_name":"apply_to","description":"\n\u003cp\u003eShould the data you’re sending also be applied to calls associated with this lead?\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be one of: \u003ccode\u003ecalls\u003c/code\u003e.","expected_type":"string","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"unblock_contact","full_name":"unblock_contact","description":"\n\u003cp\u003eRemove the caller_id from the company blacklist. Usage of this param requires passing an auth_token with permission to update Leads.\u003c/p\u003e\n","required":false,"allow_nil":false,"allow_blank":false,"validator":"Must be a boolean value: 1, true, yes, on, 0, false, no, off","expected_type":"boolean","metadata":null,"show":true,"validations":[],"deprecated":false},{"name":"blocked","full_name":"blocked","description":"\n\u003cp\u003eSet this to true in order to prevent this lead from calling any of your telephone numbers. This will also prevent all outbound actions from Trackdrive.\u003c/p\u003e\n","requi